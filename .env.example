# Copy this file to .env.local and fill in real values.
# Do not commit .env.local.

# Local MongoDB — start with: docker compose up -d
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB="agrismart_local"

# Groq is tried first for scans and Ask AI. Get a key at https://console.groq.com/keys
GROQ_API_KEY=""

# Gemini is the fallback if Groq is down.
# Official Google names: GEMINI_API_KEY or GOOGLE_API_KEY
# Vercel AI SDK also reads GOOGLE_GENERATIVE_AI_API_KEY. Use the same key for all three.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""
GEMINI_API_KEY=""

JWT_SECRET="change-me-in-local-development"

# Optional local cassava fallback classifier
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"
PREDICTION_API_URL="http://localhost:8000/predict"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
